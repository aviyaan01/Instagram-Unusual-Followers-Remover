# ==============================================================================
# INSTAGRAM FOLLOWER CLEANER - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and customize your settings if desired.
# Note: '.env' is ignored by git and will NEVER be pushed to GitHub.

# Target username (optional: leave empty to auto-detect from active session)
TARGET_USERNAME=""

# Execution Mode: False = LIVE removals enabled, True = Dry Run simulation only
DRY_RUN=False

# Live In-Loop Removal: True = remove candidates immediately when found
LIVE_REMOVE_IN_LOOP=True

# Auto-Confirm Removal: True = remove without waiting for manual 'y/n' prompts
AUTO_CONFIRM_REMOVAL=True

# Scope: Number of new unscanned followers to evaluate from the top (e.g. 150, or 'unlimited')
MAX_FOLLOWERS_TO_SCAN=150

# Maximum accounts to remove in a single session (safety threshold default: 180)
MAX_REMOVALS_PER_RUN=180

# Rule 1: Following - Followers difference threshold
MIN_DIFF=300

# Rule 2: Days without posting to consider inactive (60 = 2 months)
INACTIVE_DAYS_THRESHOLD=60

# Rule 3: Protection: NEVER remove accounts with more than 10 posts
KEEP_USERS_WITH_POSTS_OVER=10

# Rule 4: Repeat Protection: Never scan the same user twice across runs
SKIP_PREVIOUSLY_SCANNED=True

# Browser Configuration
USE_REAL_CHROME=True
HEADLESS=False
